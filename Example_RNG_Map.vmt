// =====================================================================
// Example_RNG_Map.vmt —— 随机皮肤示例（地图静态物件版）
//
// 改写自 Steam 指南 "RNG in 10 seconds (for modders)" by Ellie
//   https://steamcommunity.com/sharedfiles/filedetails/?id=2389582650
//   对应指南的 🔶 "RNG Map 2020 (inline)"
//
// 指南为什么需要这个版本：
//   地图上的静态物件（永不移动）用 ⚪️ 版本会**加载即崩溃**，因为 ⚪️ 依赖
//   EntityRandom，而静态物件没有实体。🔶 改用 PlayerPosition 算玩家坐标
//   当随机源，于是皮肤会随玩家走动而变 —— 对静态物件来说这本身也不理想，
//   只是当时没有办法。
//
// 本插件的做法：
//   l4nrp_random 的种子来自材质实例地址 + 系统时间，**不依赖实体**，
//   因此静态物件直接用 Example_RNG.vmt 就行，不需要单独的 "Map" 版本。
//   本文件保留下来只为一件事：如果你确实想要指南那种
//   「皮肤随玩家位置变化」的效果，用 l4nrp_random 的 unit 参数接
//   PlayerPosition 即可（见下），此时它就是 🔶 的等价物。
//
// ---------------------------------------------------------------------
// 用法
// ---------------------------------------------------------------------
//   1. 多帧 VTF（每帧一个皮肤）；
//   2. 静态物件（地图道具、场景装饰）推荐直接用 Example_RNG.vmt；
//   3. 只有想复刻「随玩家位置换皮肤」时才用本文件，并按需调整
//      $distancePerFrame（每多少距离换一帧，指南默认 4000）。
// =====================================================================
VertexLitGeneric
{
    "$basetexture" "models/props/your_multiframe_texture"

    // ---------- 可调参数 ----------
    "$distancePerFrame" "4000" // 每移动这么多距离换一个皮肤
    "$oneSkinPerMap"    "0"

    // ---------- 帧数探测所需的变量 ----------
    "$checkMax"         "0.0"
    "$maxFrame"         "0.0"
    "$maxFramePlusOne"  "1.0"
    "$countingFinished" "0.0"
    "$zero" "0.0"
    "$one"  "1.0"

    // ---------- 玩家位置 → [0,1) 随机比例 ----------
    "$pos"         "[0 0 0]" // PlayerPosition 输出（向量）
    "$posX"        "0.0"
    "$posY"        "0.0"
    "$distanceRollback" "1.0" // = $distancePerFrame * 帧数

    // ---------- l4nrp_random 的输入 / 输出 ----------
    "$randUnit"   "0.0" // 归一化到 [0,1) 的位置比例
    "$frame"      "0.0" // 输出帧号（上界直接用 $maxFramePlusOne = 帧数）

    "Proxies"
    {
        // =============================================================
        // 1) 帧数探测（与 Example_RNG.vmt 相同）
        // =============================================================
        LessOrEqual
        {
            LessEqualVar "$maxFrame"
            greaterVar   "$checkMax"
            srcVar1      "$checkMax"
            srcVar2      "$maxFrame"
            resultVar    "$maxFrame"
        }
        LessOrEqual
        {
            LessEqualVar "$one"
            greaterVar   "$countingFinished"
            srcVar1      "$checkMax"
            srcVar2      "$zero"
            resultVar    "$countingFinished"
        }
        LessOrEqual
        {
            LessEqualVar "$zero"
            greaterVar   "$countingFinished"
            srcVar1      "$maxFrame"
            srcVar2      "$zero"
            resultVar    "$countingFinished"
        }
        Add
        {
            srcVar1  "$maxFrame"
            srcVar2  "$one"
            resultVar "$maxFramePlusOne"
        }
        AnimatedTexture
        {
            animatedtexturevar         "$basetexture"
            animatedtextureframenumvar "$checkMax"
            animatedtextureframerate   "25"
        }

        // =============================================================
        // 2) 玩家位置 → 归一化随机比例（对应 🔶 的 PlayerPosition 部分）
        //
        //    指南用 Clamp + Abs + Divide + Frac 把坐标揉成一个 [0,1) 的数；
        //    这里用 l4nrp_math 一条表达式做完同样的事，省掉 8 个中间变量：
        //      frac((abs(posX) + abs(posY)) / distanceRollback)
        //    $pos[0] / $pos[1] 分别取向量分量（引擎代理 Clamp 的用法）。
        // =============================================================
        PlayerPosition
        {
            scale     "1"
            resultVar "$pos"
        }
        // 用 Clamp 把向量分量取成标量（引擎没有直接的 "取分量" 代理）
        Clamp
        {
            srcVar1  "$zero"
            min      "$pos[0]"
            max      "$pos[0]"
            resultVar "$posX"
        }
        Clamp
        {
            srcVar1  "$zero"
            min      "$pos[1]"
            max      "$pos[1]"
            resultVar "$posY"
        }
        // 距离回绕长度 = 每帧距离 × 帧数
        Multiply
        {
            srcVar1  "$distancePerFrame"
            srcVar2  "$maxFramePlusOne"
            resultVar "$distanceRollback"
        }
        // 一条表达式：把 |x|+|y| 除以回绕长度后取小数部分
        l4nrp_math
        {
            expr     "frac((abs(posX) + abs(posY)) / distanceRollback)"
            result   "$randUnit"
        }

        // =============================================================
        // 3) 随机皮肤
        //
        //    unit 参数接 $randUnit：给了外部随机源后，l4nrp_random
        //    不再用内部 PRNG，而是直接把这个 [0,1) 比例缩放到 [min,max]。
        //    这正是 🔶 的语义 —— 皮肤随玩家位置变化。
        //
        //    想要指南默认的「位置固定时皮肤也固定」以外的行为，把
        //    unit 这一行删掉即可退回内部 PRNG（对静态物件更自然）。
        // =============================================================
        l4nrp_random
        {
            min     "0"
            max     "$maxFramePlusOne"
            result  "$frame"
            unit    "$randUnit"
            integer "1"
        }
    }
}
